import type { FloristMapItem } from "@/lib/fs-maps/types";

function normalizeText(value: string | null | undefined): string {
  return (value ?? "")
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function roundCoordinate(value: number): string {
  return value.toFixed(4);
}

function createFallbackKey(item: FloristMapItem): string {
  const name = normalizeText(item.shop_name || item.florist_name);
  const address = normalizeText(item.address);
  const city = normalizeText(item.city);

  return [
    name,
    address,
    city,
    roundCoordinate(item.latitude),
    roundCoordinate(item.longitude),
  ].join("|");
}

function createIdentityKeys(item: FloristMapItem): string[] {
  const keys: string[] = [];

  if (item.google_place_id) {
    keys.push(`google:${item.google_place_id}`);
  }

  if (item.florist_id && !item.florist_id.startsWith("google-")) {
    keys.push(`floristsocial:${item.florist_id}`);
  }

  keys.push(`fallback:${createFallbackKey(item)}`);

  return keys;
}

function sourcePriority(item: FloristMapItem): number {
  return item.source === "floristsocial" ? 2 : 1;
}

function selectPreferredItem(
  current: FloristMapItem,
  candidate: FloristMapItem
): FloristMapItem {
  if (sourcePriority(candidate) > sourcePriority(current)) {
    return {
      ...current,
      ...candidate,
      google_place_id:
        candidate.google_place_id ?? current.google_place_id,
      rating: candidate.rating ?? current.rating,
      review_count: candidate.review_count ?? current.review_count,
      opening_hours:
        candidate.opening_hours ?? current.opening_hours,
    };
  }

  return {
    ...candidate,
    ...current,
    google_place_id:
      current.google_place_id ?? candidate.google_place_id,
    rating: current.rating ?? candidate.rating,
    review_count: current.review_count ?? candidate.review_count,
    opening_hours:
      current.opening_hours ?? candidate.opening_hours,
  };
}

export function mergeFloristMapItems(
  ...groups: FloristMapItem[][]
): FloristMapItem[] {
  const items = groups.flat();
  const result: FloristMapItem[] = [];
  const keyToIndex = new Map<string, number>();

  for (const item of items) {
    const keys = createIdentityKeys(item);

    const existingIndex = keys
      .map((key) => keyToIndex.get(key))
      .find((index): index is number => index !== undefined);

    if (existingIndex === undefined) {
      const newIndex = result.length;
      result.push(item);

      for (const key of keys) {
        keyToIndex.set(key, newIndex);
      }

      continue;
    }

    const mergedItem = selectPreferredItem(
      result[existingIndex],
      item
    );

    result[existingIndex] = mergedItem;

    for (const key of createIdentityKeys(mergedItem)) {
      keyToIndex.set(key, existingIndex);
    }
  }

  return result;
}
