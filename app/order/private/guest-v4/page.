                      <span className="mt-1 block text-sm text-stone-600">Skriv texten som ska stå på kortet till mottagaren.</span>
                      <textarea
                        value={greetingText}
                        onChange={(event) => setGreetingText(event.target.value)}
                        rows={3}
                        placeholder="Till exempel: Grattis på födelsedagen! Många kramar från oss."
                        className="mt-3 w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 focus:border-stone-500"
                      />
                    </label>
                  )}

                  {selectedGroup === "Begravning" && (
                    <div className="mt-5 rounded-2xl bg-stone-50 p-4">
                      <h3 className="text-base font-semibold">Bandtext</h3>
                      <p className="mt-1 text-sm text-stone-600">Välj bandpris efter textlängd. Antal ord just nu: {ribbonWords}.</p>
                      <div className="mt-4 grid gap-3 md:grid-cols-2">
                        <SelectBox label="Band" value={selectedBandLabel} onChange={setSelectedBandLabel} options={funeralBandOptions.map((band) => band.label)} />
                        <SelectBox label="Bandfärg" value={bandColor} onChange={setBandColor} options={bandColorOptions} />
                      </div>
                      {selectedBand.price > 0 && ribbonWords > selectedBand.maxWords && (
                        <p className="mt-3 rounded-2xl bg-red-50 p-3 text-sm font-semibold text-red-700">
                          Vald bandnivå tillåter upp till {selectedBand.maxWords} ord. Välj högre bandpris eller korta texten.
                        </p>
                      )}
                      <div className="mt-4 grid gap-3 md:grid-cols-2">
                        <TextAreaBox label="Bandtext vänster sida" value={ribbonTextLeft} onChange={setRibbonTextLeft} placeholder="Tack för alla fina minnen" />
                        <TextAreaBox label="Bandtext höger sida" value={ribbonTextRight} onChange={setRibbonTextRight} placeholder="Familjen Andersson" />
                      </div>
                    </div>
                  )}

                  <div className="mt-5 rounded-2xl border-2 border-dashed border-stone-300 bg-white p-4">
                    <h3 className="text-base font-semibold">Bifoga inspirationsbild</h3>
                    <p className="mt-1 text-sm text-stone-600">Dra och släpp eller hämta en bild som floristen kan använda som inspiration.</p>
                    <label className="mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl bg-stone-50 px-4 py-6 text-center text-sm text-stone-600 transition hover:bg-stone-100">
                      <UploadCloud size={28} /> Dra & drop eller hämta bild
                      <input type="file" accept="image/*" onChange={(event) => setUploadedImageName(event.target.files?.[0]?.name || "")} className="hidden" />
                    </label>
                    {uploadedImageName && <p className="mt-3 truncate text-xs font-medium text-stone-700"><ImagePlus size={14} className="inline" /> {uploadedImageName}</p>}
                  </div>

                  <label className="mt-5 block">
                    <span className="text-base font-semibold">Personliga önskemål</span>
                    <span className="mt-1 block text-sm text-stone-600">Vad vill du att floristen ska tänka på?</span>
                    <textarea
                      value={personalWishes}
                      onChange={(event) => setPersonalWishes(event.target.value)}
                      rows={4}
                      placeholder={"T.ex.\n• Gärna pioner om möjligt\n• Inga liljor på grund av allergi\n• Extra romantisk känsla\n• Matcha företagets färger\n• Mottagaren älskar rosa toner"}
                      className="mt-3 w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 focus:border-stone-500"
                    />
                  </label>

                  <button
                    type="button"
                    onClick={addToOrder}
                    className="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-stone-950 px-5 py-4 text-sm font-semibold text-white transition hover:bg-stone-800 sm:w-auto"
                  >
                    <Plus size={18} /> Lägg till i beställning
                  </button>
                </div>
              </div>
            </section>
            <section className="rounded-[2rem] border border-white/70 bg-white/90 p-5 shadow-sm backdrop-blur">
              <h3 className="text-base font-semibold">Extra produkter</h3>
              <p className="mt-1 text-sm text-stone-600">Tillval som räknas med i totalsumman.</p>
              <div className="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                <PriceSelect label="Choklad" value={chocolatePrice} onChange={setChocolatePrice} options={chocolateOptions} />
                <PriceSelect label="Ballong" value={balloonPrice} onChange={setBalloonPrice} options={balloonOptions} />
                <PriceSelect label="Nalle" value={teddyPrice} onChange={setTeddyPrice} options={teddyOptions} />
                <PriceSelect label="Vas" value={vasePrice} onChange={setVasePrice} options={vaseOptions} />
                <PriceSelect label="Kruka" value={potPrice} onChange={setPotPrice} options={potOptions} />
                <label className="flex items-start gap-3 rounded-2xl bg-stone-50 p-4 text-sm text-stone-700">
                  <input type="checkbox" checked={luxuryWrap} onChange={(event) => setLuxuryWrap(event.target.checked)} className="mt-1 h-4 w-4 accent-stone-900" />
                  <span>Lyxigare inslagning 90 kr</span>
                </label>
                <label className="flex items-start gap-3 rounded-2xl bg-stone-50 p-4 text-sm text-stone-700">
                  <input type="checkbox" checked={pollenFree} onChange={(event) => setPollenFree(event.target.checked)} className="mt-1 h-4 w-4 accent-stone-900" />
                  <span>Pollenfri önskas</span>
                </label>
              </div>
            </section>
          </section>

          <aside className="rounded-[2rem] border border-white/70 bg-white/90 p-5 shadow-sm backdrop-blur lg:sticky lg:top-5 lg:self-start">
            <h2 className="text-xl font-semibold">Din beställning</h2>
            <p className="mt-1 text-sm text-stone-500">Allt kunden bygger hamnar här.</p>

            <div className="mt-5 space-y-3">
              {orderItems.length === 0 ? (
                <div className="rounded-2xl bg-stone-50 p-4 text-sm text-stone-500">Inga produkter tillagda ännu.</div>
              ) : (
                orderItems.map((item) => (
                  <div key={item.id} className="rounded-2xl border border-stone-100 bg-stone-50 p-4">
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <p className="font-semibold">{groupIcon(item.group)} {item.product}</p>
                        <p className="mt-1 text-xs leading-5 text-stone-500">
                          {item.style} · {colorLabel(item.colors)} · {item.option}
                        </p>
                        <p className="mt-1 text-xs leading-5 text-stone-500">
                          {money(item.unitPrice)} x {item.quantity} = {money(item.total)}
                        </p>
                        {item.cardText && <p className="mt-2 text-xs leading-5 text-stone-500">Kort: {item.cardText}</p>}
                        {item.ribbonText && <p className="mt-2 text-xs leading-5 text-stone-500">Band: {item.ribbonText}</p>}
                        {item.uploadedImageName && <p className="mt-2 text-xs leading-5 text-stone-500">Bild: {item.uploadedImageName}</p>}
                        {item.wishes && <p className="mt-2 text-xs leading-5 text-stone-500">{item.wishes}</p>}
                      </div>
                      <button type="button" onClick={() => removeItem(item.id)} className="rounded-full p-1 text-stone-400 hover:bg-white hover:text-red-600">
                        <Trash2 size={16} />
                      </button>
                    </div>
                  </div>
                ))
              )}
            </div>

            <div className="mt-6 border-t border-stone-100 pt-5">
              <div className="flex items-center justify-between text-sm text-stone-500">
                <span>Produktrader</span>
                <span>{orderItems.length} st</span>
              </div>
              <div className="mt-3 space-y-2 text-sm text-stone-600">
                <div className="flex items-center justify-between"><span>Produkter</span><span>{money(productTotal)}</span></div>
                <div className="flex items-center justify-between"><span>Band</span><span>{money(bandTotal)}</span></div>
                <div className="flex items-center justify-between"><span>Extra produkter</span><span>{money(extrasTotal)}</span></div>
              </div>
              <div className="mt-4 flex items-center justify-between text-xl font-semibold">
                <span>Totalt</span>
                <span>{money(total)}</span>
              </div>
            </div>

            <div className="mt-5 rounded-2xl bg-pink-50 p-4 text-sm leading-6 text-pink-950">
              <Check size={16} className="mr-1 inline" /> Detta är V4-designprototyp. Leverans, betalning och Supabase kopplas in senare.
            </div>
          </aside>
        </div>
      </div>
    </main>
  );
}

function CompactButton({ children, active, onClick }: { children: React.ReactNode; active: boolean; onClick: () => void }) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={
        "rounded-full border px-3 py-2 text-sm font-semibold transition " +
        (active ? "border-stone-950 bg-stone-950 text-white" : "border-stone-200 bg-white text-stone-700 hover:border-pink-300")
      }
    >
      {children}
    </button>
  );
}

function ControlBlock({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <div>
      <h3 className="mb-2 text-sm font-semibold text-stone-800">{title}</h3>
      {children}
    </div>
  );
}


function SelectBox({ label, value, onChange, options }: { label: string; value: string; onChange: (value: string) => void; options: string[] }) {
  return (
    <label className="block">
      <span className="mb-2 block text-sm font-semibold">{label}</span>
      <select value={value} onChange={(event) => onChange(event.target.value)} className="h-12 w-full rounded-2xl border border-stone-200 bg-white px-4 text-sm outline-none transition focus:border-stone-500">
        {options.map((option) => <option key={option} value={option}>{option}</option>)}
      </select>
    </label>
  );
}

function TextAreaBox({ label, value, onChange, placeholder }: { label: string; value: string; onChange: (value: string) => void; placeholder: string }) {
  return (
    <label className="block">
      <span className="mb-2 block text-sm font-semibold">{label}</span>
      <textarea value={value} onChange={(event) => onChange(event.target.value)} rows={3} placeholder={placeholder} className="w-full rounded-2xl border border-stone-200 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 focus:border-stone-500" />
    </label>
  );
}

function PriceSelect({ label, value, onChange, options }: { label: string; value: number; onChange: (value: number) => void; options: number[] }) {
  return (
    <label className="block">
      <span className="mb-2 block text-sm font-semibold">{label}</span>
      <select value={value} onChange={(event) => onChange(Number(event.target.value))} className="h-12 w-full rounded-2xl border border-stone-200 bg-white px-4 text-sm outline-none transition focus:border-stone-500">
        {options.map((option) => <option key={option} value={option}>{option === 0 ? "Välj" : money(option)}</option>)}
      </select>
    </label>
  );
}

function ControlCard({ title, description, children }: { title: string; description: string; children: React.ReactNode }) {
  return (
    <section className="rounded-[2rem] border border-white/70 bg-white/90 p-5 shadow-sm backdrop-blur">
      <h3 className="text-base font-semibold">{title}</h3>
      <p className="mt-1 text-sm leading-6 text-stone-600">{description}</p>
      <div className="mt-4">{children}</div>
    </section>
  );
}
