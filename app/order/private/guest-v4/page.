function money(value: number) {
  return new Intl.NumberFormat("sv-SE").format(value) + " kr";
}

function colorLabel(colors: string[]) {
  if (colors.length === 0) return "Ingen färg vald";
  return colors.join(" + ");
}

function groupIcon(name: GroupName) {
  return groups.find((group) => group.name === name)?.icon || "🌸";
}

function getPriceOptions(group: GroupName, product: string) {
  return priceOptionsByProduct[group]?.[product] || defaultPriceOptions;
}

function clampPriceForProduct(group: GroupName, product: string, currentPrice: number) {
  const prices = getPriceOptions(group, product);
  if (prices.includes(currentPrice)) return currentPrice;
  return prices[0] || 500;
}

