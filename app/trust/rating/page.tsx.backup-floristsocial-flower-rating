"use client";

import { useState } from "react";
import {
  CalendarDays,
  Heart,
  Palette,
  Smile,
  Truck,
  Trophy,
} from "lucide-react";

const categories = [
  { key: "quality", label: "Kvalitet", icon: <Trophy size={28} /> },
  { key: "design", label: "Form & design", icon: <Heart size={28} /> },
  { key: "color", label: "Färg", icon: <Palette size={28} /> },
  { key: "delivery", label: "Leverans", icon: <Truck size={28} /> },
] as const;

export default function TrustRatingPage() {
  const [ratings, setRatings] = useState({
    quality: 0,
    design: 0,
    color: 0,
    delivery: 0,
  });

  const [wouldOrderAgain, setWouldOrderAgain] = useState<boolean | null>(null);

  function setRating(key: keyof typeof ratings, value: number) {
    setRatings((current) => ({ ...current, [key]: value }));
  }

  return (
    <main className="min-h-screen bg-[#faf8f5] px-4 py-10 text-slate-950">
      <section className="mx-auto max-w-5xl rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-10">
        <div className="text-center">
          <div className="mx-auto grid h-20 w-20 place-items-center rounded-full text-pink-600">
            <div className="text-6xl leading-none">♡</div>
          </div>

          <h1 className="mt-4 text-4xl font-black tracking-tight">
            Tack för ditt köp!
          </h1>

          <p className="mt-3 text-lg font-semibold text-slate-600">
            Vi hoppas du är nöjd med din beställning.
            <br />
            Din feedback hjälper florister att växa och bli ännu bättre.
          </p>
        </div>

        <div className="mt-8 flex items-center gap-5 rounded-3xl border border-pink-200 bg-pink-50/50 p-5">
          <div className="grid h-14 w-14 place-items-center rounded-2xl bg-pink-100 text-pink-600">
            <CalendarDays size={30} />
          </div>

          <div>
            <h2 className="text-xl font-black">
              Beställning #FS-4587 levererades 8 juli 2026
            </h2>
            <p className="mt-1 text-base font-semibold text-slate-600">
              Din upplevelse är viktig för oss.
            </p>
          </div>
        </div>

        <div className="mt-8">
          <h2 className="text-2xl font-black">
            Hur skulle du betygsätta din upplevelse?
          </h2>
          <p className="mt-2 text-base font-semibold text-slate-600">
            Klicka på en blomma (1–5) i varje kategori.
          </p>
        </div>

        <div className="mt-5 overflow-hidden rounded-3xl border border-pink-200">
          {categories.map((category) => (
            <div
              key={category.key}
              className="grid grid-cols-[210px_1fr] items-center border-b border-pink-100 last:border-b-0"
            >
              <div className="flex items-center gap-4 p-5 font-black">
                <span className="text-pink-600">{category.icon}</span>
                {category.label}
              </div>

              <div className="grid grid-cols-5 gap-3 p-4">
                {[1, 2, 3, 4, 5].map((score) => {
                  const active = ratings[category.key] >= score;

                  return (
                    <button
                      key={score}
                      type="button"
                      onClick={() => setRating(category.key, score)}
                      className="grid place-items-center rounded-2xl py-2 transition hover:bg-pink-50"
                    >
                      <span
                        className={`text-4xl ${
                          active ? "text-pink-600" : "text-pink-200"
                        }`}
                      >
                        ♡
                      </span>
                      <span className="mt-1 text-sm font-black">{score}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <div className="mt-6 grid gap-5 rounded-3xl border border-pink-200 bg-pink-50/40 p-5 md:grid-cols-[1fr_260px_260px] md:items-center">
          <div className="flex items-center gap-5">
            <Heart size={42} className="text-pink-600" />
            <div>
              <h2 className="text-xl font-black">
                Skulle du beställa från denna florist igen?
              </h2>
              <p className="mt-1 font-semibold text-slate-600">
                Ditt svar hjälper andra kunder.
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={() => setWouldOrderAgain(true)}
            className={`flex h-16 items-center justify-center gap-3 rounded-2xl border text-lg font-black ${
              wouldOrderAgain === true
                ? "border-pink-600 bg-pink-600 text-white"
                : "border-pink-200 bg-white text-pink-700"
            }`}
          >
            <Smile size={26} />
            Ja, absolut!
          </button>

          <button
            type="button"
            onClick={() => setWouldOrderAgain(false)}
            className={`flex h-16 items-center justify-center gap-3 rounded-2xl border text-lg font-black ${
              wouldOrderAgain === false
                ? "border-pink-600 bg-pink-600 text-white"
                : "border-pink-200 bg-white text-pink-700"
            }`}
          >
            Nej, tyvärr
          </button>
        </div>

        <p className="mt-7 text-center text-lg font-black text-pink-600">
          Tack för att du hjälper oss att sprida blomsterglädje! 🌷
        </p>
      </section>
    </main>
  );
}
