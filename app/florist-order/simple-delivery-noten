function ShopBlock({ title, shop }: { title: string; shop: { name: string; address1: string; address2: string; email: string; phone: string } }) {
  return (
    <div>
      <Title>{title}</Title>
      <p style={smallText}>{shop.name}<br />{shop.address1}<br />{shop.address2}<br />{shop.email}<br />{shop.phone}</p>
    </div>
  );
}

function StrongLine({ label, value, alignRight = false }: { label: string; value: string; alignRight?: boolean }) {
  return (
    <div style={{ textAlign: alignRight ? "right" : "left", fontSize: 14 }}>
      <strong>{label}</strong> {value}
    </div>
  );
}

function Title({ children, top = false }: { children: React.ReactNode; top?: boolean }) {
  return <div style={{ marginTop: top ? 10 : 0, fontWeight: 900, fontSize: 15 }}>{children}</div>;
}

