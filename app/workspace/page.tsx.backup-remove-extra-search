import Link from "next/link";
import {
  Bell,
  Brain,
  CalendarDays,
  CreditCard,
  Package,
  Search,
  ShieldCheck,
  Truck,
  Users,
  Sparkles,
  PlusCircle,
  FileText,
  Flower2,
} from "lucide-react";
import {
  getMorningBriefing,
  getWorkspaceCards,
} from "@/engines/workspace/services/WorkspaceService";
import type { WorkspaceCard } from "@/engines/workspace/types";
import FloristFlower from "@/components/brand/FloristFlower";

const iconMap: Record<string, React.ReactNode> = {
  orders: <Package size={24} />,
  calendar: <CalendarDays size={24} />,
  trust: <ShieldCheck size={24} />,
  crm: <Users size={24} />,
  economy: <CreditCard size={24} />,
  intelligence: <Brain size={24} />,
  notification: <Bell size={24} />,
};

export default async function WorkspacePage() {
  const briefing = await getMorningBriefing();
  const cards = await getWorkspaceCards();

  return (
    <main className="min-h-screen bg-[#f7f2ea] px-4 py-8 text-slate-950 sm:px-6 lg:px-8">
      <div className="mx-auto max-w-7xl space-y-6">
        <section className="grid gap-6 lg:grid-cols-[1.35fr_0.65fr]">
          <div className="overflow-hidden rounded-[2.25rem] bg-white shadow-xl shadow-slate-200/70">
            <div className="grid min-h-[330px] gap-6 bg-gradient-to-br from-pink-50 via-white to-emerald-50 p-7 sm:p-10 lg:grid-cols-[1fr_300px]">
              <div>
                <p className="mb-4 inline-flex rounded-full bg-pink-100 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-pink-700">
                  FloristSocial Arbetsyta
                </p>

                <h1 className="text-4xl font-black tracking-tight sm:text-6xl">
                  {briefing.greeting}
                </h1>

                <p className="mt-4 max-w-2xl text-base font-semibold leading-7 text-slate-600">
                  Din samlade arbetsplats för order, kalender, relationer,
                  ekonomi, Trust och FOS-rekommendationer.
                </p>

                <div className="mt-7 grid gap-3 sm:grid-cols-2">
                  {briefing.messages.slice(0, 4).map((message) => (
                    <div
                      key={message}
                      className="rounded-2xl border border-pink-100 bg-white/85 px-4 py-3 text-sm font-bold text-slate-700 shadow-sm"
                    >
                      {message}
                    </div>
                  ))}
                </div>

                <div className="mt-7 flex h-12 max-w-xl items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 shadow-sm">
                  <Search size={18} className="text-pink-700" />
                  <input
                    placeholder="Sök i FloristSocial..."
                    className="w-full bg-transparent text-sm font-bold outline-none"
                  />
                  <span className="rounded-xl bg-slate-100 px-3 py-1 text-xs font-black text-slate-500">
                    ⌘ K
                  </span>
                </div>
              </div>

              <div className="hidden items-center justify-center lg:flex">
                <div className="relative grid h-64 w-64 place-items-center rounded-full bg-white/70 shadow-inner">
                  <div className="absolute h-48 w-48 rounded-full bg-pink-100/70" />
                  <Flower2 size={142} className="relative text-pink-600" />
                </div>
              </div>
            </div>
          </div>

          <aside className="rounded-[2.25rem] bg-white p-6 shadow-xl shadow-slate-200/70">
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-xs font-black uppercase tracking-[0.18em] text-pink-700">
                  Dagens kalender
                </p>
                <h2 className="mt-2 text-2xl font-black tracking-tight">
                  Viktigast idag
                </h2>
              </div>
              <CalendarDays className="text-pink-700" size={30} />
            </div>

            <div className="mt-6 space-y-3">
              <MiniTask time="Idag" title="4 leveranser" />
              <MiniTask time="Före 13:00" title="2 buketter planeras dagen innan" />
              <MiniTask time="48 h efter leverans" title="Trust Rating skickas" />
            </div>

            <Link
              href="/workspace/calendar"
              className="mt-6 inline-flex h-11 w-full items-center justify-center rounded-2xl bg-pink-600 px-5 text-sm font-black text-white hover:bg-pink-700"
            >
              Öppna kalender
            </Link>
          </aside>
        </section>

        <section>
          <div className="mb-4 flex items-end justify-between">
            <div>
              <p className="text-xs font-black uppercase tracking-[0.18em] text-pink-700">
                FOS överblick
              </p>
              <h2 className="mt-1 text-2xl font-black tracking-tight">
                Din arbetsdag
              </h2>
            </div>
          </div>

          <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {cards.map((card) => (
              <WorkspaceCardView key={card.id} card={card} />
            ))}
          </div>
        </section>

        <section className="grid gap-5 lg:grid-cols-3">
          <QuickAction title="Ny order" icon={<PlusCircle size={22} />} href="/orders" />
          <QuickAction title="Ny leverans" icon={<Truck size={22} />} href="/workspace/calendar" />
          <QuickAction title="Ny offert" icon={<FileText size={22} />} href="/workspace" />
        </section>
      </div>
    </main>
  );
}

function MiniTask({ time, title }: { time: string; title: string }) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <p className="text-xs font-black uppercase tracking-[0.14em] text-slate-400">
        {time}
      </p>
      <p className="mt-1 text-sm font-black text-slate-900">{title}</p>
    </div>
  );
}

function WorkspaceCardView({ card }: { card: WorkspaceCard }) {
  const isTrust = card.id === "trust";

  return (
    <section className="flex min-h-[190px] flex-col justify-between rounded-[1.75rem] border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-xl">
      <div>
        <div className="mb-5 flex items-start justify-between gap-4">
          <div className="grid h-13 w-13 place-items-center rounded-2xl bg-pink-50 text-pink-700">
            {isTrust ? <FloristFlower size={28} /> : iconMap[card.id] || <CalendarDays size={24} />}
          </div>

          {card.value !== undefined && (
            <div className="rounded-full bg-slate-50 px-4 py-2 text-sm font-black text-slate-900">
              {card.value}
            </div>
          )}
        </div>

        <h3 className="text-xl font-black tracking-tight">{card.title}</h3>

        {card.subtitle && (
          <p className="mt-2 text-sm font-semibold leading-6 text-slate-600">
            {card.subtitle}
          </p>
        )}
      </div>

      {card.href && (
        <Link
          href={card.href}
          className="mt-5 inline-flex h-11 w-fit items-center justify-center rounded-2xl bg-pink-600 px-5 text-sm font-black text-white hover:bg-pink-700"
        >
          Öppna
        </Link>
      )}
    </section>
  );
}

function QuickAction({
  title,
  icon,
  href,
}: {
  title: string;
  icon: React.ReactNode;
  href: string;
}) {
  return (
    <Link
      href={href}
      className="flex items-center gap-4 rounded-[1.75rem] border border-pink-100 bg-white p-5 text-sm font-black text-slate-900 shadow-sm hover:bg-pink-50"
    >
      <span className="grid h-12 w-12 place-items-center rounded-2xl bg-pink-50 text-pink-700">
        {icon}
      </span>
      {title}
    </Link>
  );
}
