# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> Signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Connect settings if you later need client-side Connect flows
STRIPE_CONNECT_CLIENT_ID=
# Developers -> API keys -> Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel runtime host fallback
VERCEL_URL=
